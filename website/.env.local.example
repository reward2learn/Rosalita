# TokenizMyApp — copy to .env.local and fill in values.
# Never commit .env.local or Google client_secret JSON files.

POSTGRES_URL=
ENCRYPTION_KEY=
SETUP_TOKEN=

# Google OAuth — optional when using DB-backed config (npm run seed:google-oauth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

OPENAI_API_KEY=
# Chat model for SSE streaming (default gpt-4o-mini)
OPENAI_CHAT_MODEL=
# Model used when web search is enabled in /config (default gpt-4o-mini-search-preview)
OPENAI_WEB_SEARCH_MODEL=

# ── Tenant Configuration ──────────────────────────────
# These env vars parameterize the app for multi-tenant deployments.
# Set on Vercel per-project to customize each tenant's identity.
# When unset, defaults to "tokenizmyapp" / "Tokeniz My App".

# Subdomain slug — used for URL derivation (e.g. "redrubybali" → redrubybali.vercel.app)
NEXT_PUBLIC_TENANT_SLUG=

# Human-readable business name (e.g. "Red Ruby Bali")
NEXT_PUBLIC_TENANT_DISPLAY_NAME=

# Meta description / tagline (defaults to "{displayName} business operations dashboard")
NEXT_PUBLIC_TENANT_DESCRIPTION=

# HTML <title> override — defaults to NEXT_PUBLIC_TENANT_DISPLAY_NAME if unset
NEXT_PUBLIC_TENANT_APP_TITLE=

# Canonical app URL — overrides slug-based derivation (OAuth redirects, absolute links)
NEXT_PUBLIC_APP_URL=https://tokenizmyapp.vercel.app
